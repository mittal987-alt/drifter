# ============================================================
# Drifter — Environment Configuration Template
# ============================================================
# Copy this file to .env (repo root) AND backend/.env for local development.
#   cp .env.example .env
#   cp .env.example backend/.env
#
# Never commit real API keys, OAuth secrets, or passwords to version control.
# ============================================================

# ── Application ────────────────────────────────────────────
ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── Security ───────────────────────────────────────────────
# Generate a strong secret for production:
#   openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# ── Database ───────────────────────────────────────────────
# Local SQLite (default):
DATABASE_URL=sqlite:///./year_in_drift.db
# PostgreSQL (Docker / production) — use psycopg2, NOT asyncpg:
# DATABASE_URL=postgresql+psycopg2://drifter:drifter_secret_password@localhost:5432/drifter

# ── PostgreSQL (Docker Compose) ────────────────────────────
POSTGRES_DB=drifter
POSTGRES_USER=drifter
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD

# ── Google OAuth — YouTube & Google Takeout Portability ────
# Register at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# ── Spotify OAuth — Listening History Sync ─────────────────
# Register at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=REPLACE_WITH_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=REPLACE_WITH_SPOTIFY_CLIENT_SECRET
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/spotify/callback

# ── GitHub OAuth — Developer & Repository Activity Sync ────
# Register at https://github.com/settings/developers
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/github/callback

# ── Reddit OAuth — Subreddit Curiosity & Discussion Sync ───
# Register at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=REPLACE_WITH_REDDIT_CLIENT_ID
REDDIT_CLIENT_SECRET=REPLACE_WITH_REDDIT_CLIENT_SECRET
REDDIT_REDIRECT_URI=http://127.0.0.1:8000/api/reddit/callback

# ── AI / LLM API Keys (Optional) ──────────────────────────
# Enables LLM-powered Drifter Chat and narrative reports.
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY_OR_LEAVE_EMPTY
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY_OR_LEAVE_EMPTY

# ── Frontend (Vite) ────────────────────────────────────────
# These must be in frontend/.env — Vite only exposes VITE_ prefixed vars.
VITE_API_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000