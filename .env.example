# Drifter Project Environment Configuration Example
# Copy this file to `.env` (root), `backend/.env`, and `frontend/.env` as needed.

# Application Core URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Security & Storage
SESSION_SECRET=drifter-local-secret-change-me
DATABASE_URL=sqlite:///./year_in_drift.db

# Google OAuth — YouTube & Google Takeout Portability
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Spotify OAuth — Listening History Sync
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/spotify/callback

# GitHub OAuth — Developer & Repository Activity Sync
# Register at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/github/callback

# Reddit OAuth — Subreddit Curiosity & Discussion Sync
# Register at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_REDIRECT_URI=http://127.0.0.1:8000/api/reddit/callback

# AI / LLM API Keys (Optional - Enables external LLM synthesis for Drifter Chat)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Frontend Environment Variables (Prefix with VITE_)
VITE_API_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000