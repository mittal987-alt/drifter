GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/spotify/callback
SESSION_SECRET=drifter-local-secret-change-me
DATABASE_URL=sqlite:///./year_in_drift.db

# GitHub OAuth — register at https://github.com/settings/developers
# Callback URL: http://127.0.0.1:8000/api/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Reddit OAuth — register at https://www.reddit.com/prefs/apps
# App type: "web app"  |  Callback URL: http://127.0.0.1:8000/api/reddit/callback
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret